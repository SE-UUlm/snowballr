# Serves the gRPC API documentation, which the backend serves under /grpc-docs/, publicly under /docs/
# Argument: address of the backend's HTTP (REST) server
(docs-config) {
	handle_path /docs/* {
		rewrite / /grpc-docs/index.html
		rewrite * /grpc-docs{uri}
		reverse_proxy {args[0]}
	}
	redir /docs /docs/ permanent
}

# Reverse proxy configuration for production setup
{$PROD_DOMAIN} {
	import docs-config http://backend:8090

	handle_path /api/* {
		reverse_proxy http://proxy:9100
	}

	reverse_proxy http://frontend:8000
}

# Reverse proxy configuration for development setup
{$DEV_DOMAIN} {
	import docs-config http://backend-development:8090

	handle_path /api/* {
		reverse_proxy http://proxy-development:9101
	}

	reverse_proxy http://frontend-development:8001
}
